# Minimal receive-only example. Review the Dire Wolf documentation and local
# amateur-radio requirements before using this configuration.
ADEVICE stdin null
CHANNEL 0
MYCALL N0CALL-10
MODEM 1200

IGSERVER rotate.aprs2.net 14580
# Add IGLOGIN with your own callsign and APRS-IS passcode on the target system.

# Replace these example coordinates and beacon text with your station details.
PBEACON sendto=IG delay=0:30 every=30:00 symbol="igate" lat=00^00.00N long=000^00.00E comment="Receive-only APRS iGate"
