# Copy this file to /etc/default/aprsgate-wifi and replace every value that
# depends on the target system.
APRSGATE_WIFI_DEVICE=wlan1
APRSGATE_WIFI_PORTAL_PORT=8088
APRSGATE_SETUP_SSID=APRSgate-Setup
APRSGATE_SETUP_PASSWORD=
APRSGATE_SETUP_CONNECTION=aprsgate-setup-ap
APRSGATE_WIFI_CHECK_INTERVAL=30

APRSGATE_PRIMARY_WIFI_DEVICE=wlan1
APRSGATE_PRIMARY_WIFI_CONNECTION=primary-wifi
APRSGATE_FALLBACK_WIFI_DEVICE=wlan0
APRSGATE_FALLBACK_WIFI_CONNECTION=fallback-wifi

# Optional USB ID used to rebind an external adapter after a failed USB start.
# Leave both values empty to disable USB driver rebinding.
APRSGATE_PRIMARY_USB_VENDOR=
APRSGATE_PRIMARY_USB_PRODUCT=
APRSGATE_WIFI_FAILOVER_INTERVAL=15
